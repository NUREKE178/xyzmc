# Токен бота: https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# ID вашего Discord-сервера (ПКМ по серверу -> Копировать ID, включите режим разработчика)
GUILD_ID=
# Общий секрет между ботом и плагином (минимум 16 символов). Должен совпадать с api-secret в config.yml плагина
API_SECRET=
# Порт и адрес внутреннего API, к которому подключается плагин
API_PORT=8788
API_HOST=0.0.0.0
# Где хранить привязки
DATA_FILE=./data/links.json
